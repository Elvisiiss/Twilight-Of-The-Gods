; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Twilight of the Gods"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

0/name="EventBus"
0/path="res://Scripts/Core/EventBus.gd"
0/enabled=true
1/name="GameManager"
1/path="res://Scripts/Core/GameManager.gd"
1/enabled=true
2/name="DataManager"
2/path="res://Scripts/Data/DataManager.gd"
2/enabled=true
3/name="InputManager"
3/path="res://Scripts/Core/InputManager.gd"
3/enabled=true
4/name="ObjectPool"
4/path="res://Scripts/Core/ObjectPool.gd"
4/enabled=true
5/name="MapManager"
5/path="res://Scripts/World/MapManager.gd"
5/enabled=true
6/name="QuestManager"
6/path="res://Scripts/Quest/QuestManager.gd"
6/enabled=true
7/name="DamageSystem"
7/path="res://Scripts/Combat/DamageSystem.gd"
7/enabled=true
8/name="CCSystem"
8/path="res://Scripts/Combat/CCSystem.gd"
8/enabled=true
9/name="PKSystem"
9/path="res://Scripts/Combat/PKSystem.gd"
9/enabled=true

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/title="Twilight of the Gods"
window/resizable=false

[input]

mouse_cursor/hidden=false
mouse_cursor/use_custom_cursor=false
